DATABASE_URL=postgresql://postgres:postgres@db:5432/bomts
QDRANT_URL=http://qdrant:6333
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODE=mock

LLM_PROVIDER=mock

# OpenClaw Local LLM Provider
OPENCLAW_ENABLED=false
OPENCLAW_BASE_URL=
OPENCLAW_DEFAULT_MODEL=gemma3:4b
OPENCLAW_TIMEOUT_SECONDS=60

# Google Provider
GOOGLE_API_KEY=
GOOGLE_PROVIDER_ENABLED=false
GOOGLE_TRANSLATION_ENABLED=false
GOOGLE_DEFAULT_MODEL=gemini-1.5-flash
